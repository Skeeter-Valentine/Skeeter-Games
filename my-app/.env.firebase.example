# Copy these into .env.local for development and Netlify environment variables.
# Firebase Console > Project settings > General > Your apps > Web app config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Enable after deploying functions/rules and enabling Anonymous authentication.
VITE_PUZZLE_RESULTS_ENABLED=false
